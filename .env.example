# Database (SQLite by default for local dev; point at Postgres in shared environments)
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# Transcription provider (unset -> local mock transcription provider is used)
TRANSCRIPTION_PROVIDER="mock"
# TRANSCRIPTION_API_KEY=""

# Flow Builder integration (unset -> console/mock adapter logs events instead of calling Flow Builder)
FLOWBUILDER_BASE_URL=""
FLOWBUILDER_API_KEY=""

# Audio retention (default: do not persist raw audio)
RETAIN_RAW_AUDIO="false"
